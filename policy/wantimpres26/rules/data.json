{
  "version": "builtin-1",
  "items": [
    {
      "id": "tpl.kill-switch",
      "description": "FR-AGT-7: kill switch aktif untuk agent, tool, app, atau global = block semua aksi agent.",
      "when": [
        {"field": "agent.killed", "op": "eq", "value": true}
      ],
      "action": "block",
      "reason": "KILL_SWITCH"
    },
    {
      "id": "tpl.agent-not-active",
      "description": "FR-AGT-1: agent quarantined (mis. tanpa owner) atau suspended di registry = block semua aksinya.",
      "when": [
        {"field": "agent.status", "op": "in", "value": ["quarantined", "suspended"]}
      ],
      "action": "block",
      "reason": "AGENT_NOT_ACTIVE"
    },
    {
      "id": "tpl.tool-not-allowed",
      "description": "FR-AGT-4: tool di luar allow-list agent di registry = block (agent tak terdaftar tidak punya allow-list).",
      "when": [
        {"field": "direction", "op": "eq", "value": "tool_call"},
        {"field": "agent.tool_allowed", "op": "eq", "value": false}
      ],
      "action": "block",
      "reason": "TOOL_NOT_ALLOWED"
    },
    {
      "id": "tpl.mcp-tool-not-approved",
      "description": "FR-AGT-3: tool MCP yang definisinya belum/tidak di-approve, atau berubah sejak di-pin (rug pull), = block sampai di-approve ulang.",
      "when": [
        {"field": "direction", "op": "eq", "value": "tool_call"},
        {"field": "agent.mcp_server", "op": "neq", "value": null},
        {"field": "agent.tool_approved", "op": "eq", "value": false}
      ],
      "action": "block",
      "reason": "TOOL_NOT_APPROVED"
    },
    {
      "id": "tpl.tool-scope-violation",
      "description": "FR-AGT-4: argumen tool call di luar scope parameter registry (mis. amount > max, recipient di luar allow-list) = block.",
      "when": [
        {"field": "agent.scope_violations", "op": "gte", "value": 1}
      ],
      "action": "block",
      "reason": "TOOL_SCOPE_VIOLATION"
    },
    {
      "id": "tpl.tool-rate-limit",
      "description": "FR-AGT-4: melebihi rate tool per agent = block.",
      "when": [
        {"field": "agent.rate_exceeded", "op": "eq", "value": true}
      ],
      "action": "block",
      "reason": "TOOL_RATE_LIMITED"
    },
    {
      "id": "tpl.agent-chain-depth",
      "description": "FR-AGT-4: rantai agent-ke-agent lebih dari 3 hop (nesting act di token) = block.",
      "when": [
        {"field": "agent.chain_depth", "op": "gte", "value": 4}
      ],
      "action": "block",
      "reason": "AGENT_CHAIN_TOO_DEEP"
    },
    {
      "id": "tpl.indirect-injection",
      "description": "FR-PSEC-2: tool result / resource read (untrusted) dengan injection_score >= 0.7 = block sebelum sampai ke agent.",
      "when": [
        {"field": "direction", "op": "eq", "value": "tool_result"},
        {"field": "content.injection_score", "op": "gte", "value": 0.7}
      ],
      "action": "block",
      "reason": "INDIRECT_INJECTION"
    },
    {
      "id": "tpl.injection-then-high-tool",
      "description": "FR-AGT-6, FR-RISK-2: sesi yang sudah melihat injection >= 0.5 lalu memanggil tool high = require_approval (tanpa HITL = deny).",
      "when": [
        {"field": "direction", "op": "eq", "value": "tool_call"},
        {"field": "agent.tool_risk", "op": "eq", "value": "high"},
        {"field": "agent.session_injection_max", "op": "gte", "value": 0.5}
      ],
      "action": "require_approval",
      "reason": "INJECTION_THEN_HIGH_TOOL"
    },
    {
      "id": "tpl.memory-write-injection",
      "description": "FR-AGT-9, OWASP ASI06: tulis ke memory agent / vector store berisi injection >= 0.5 = block. Yang tersimpan dibaca ulang sesi lain sebagai konteks tepercaya, jadi ambangnya lebih rendah dari tpl.injection-high.",
      "when": [
        {"field": "direction", "op": "eq", "value": "tool_call"},
        {"field": "agent.writes_memory", "op": "eq", "value": true},
        {"field": "content.injection_score", "op": "gte", "value": 0.5}
      ],
      "action": "block",
      "reason": "MEMORY_POISONING"
    },
    {
      "id": "tpl.memory-write-tainted",
      "description": "FR-AGT-9: sesi yang sudah melihat injection >= 0.5 menulis ke memory = require_approval (tanpa HITL = deny).",
      "when": [
        {"field": "direction", "op": "eq", "value": "tool_call"},
        {"field": "agent.writes_memory", "op": "eq", "value": true},
        {"field": "agent.session_injection_max", "op": "gte", "value": 0.5}
      ],
      "action": "require_approval",
      "reason": "MEMORY_WRITE_TAINTED_SESSION"
    },
    {
      "id": "tpl.blocked-app",
      "description": "FR-DISC-4: app berstatus blocked di katalog = block (semua sensitivity, onshore maupun offshore).",
      "when": [
        {"field": "direction", "op": "in", "value": ["request", "tool_call"]},
        {"field": "destination.sanction", "op": "eq", "value": "blocked"}
      ],
      "action": "block",
      "reason": "APP_BLOCKED"
    },
    {
      "id": "tpl.pii-id-to-unsanctioned",
      "description": "FR-POL-8: PII-ID ke AI yang tidak sanctioned = block.",
      "when": [
        {"field": "direction", "op": "in", "value": ["request", "tool_call"]},
        {"field": "destination.sanction", "op": "in", "value": ["unsanctioned", "blocked", "under_review"]},
        {"field": "content.classes", "op": "class_any", "value": ["PII_ID.*"]}
      ],
      "action": "block",
      "reason": "PII_ID_TO_UNSANCTIONED_AI"
    },
    {
      "id": "tpl.secret-to-any-ai",
      "description": "FR-POL-8: credentials/secrets ke AI mana pun = block.",
      "when": [
        {"field": "direction", "op": "in", "value": ["request", "tool_call"]},
        {"field": "content.classes", "op": "class_any", "value": ["SECRET.*"]}
      ],
      "action": "block",
      "reason": "SECRET_TO_AI"
    },
    {
      "id": "tpl.pci-pan-redact",
      "description": "FR-POL-8: PCI PAN = redact (semua arah, termasuk response).",
      "when": [
        {"field": "content.classes", "op": "class_any", "value": ["PCI.PAN"]}
      ],
      "action": "redact",
      "obligations": [{"type": "redact", "classes": ["PCI.PAN"]}],
      "reason": "PCI_PAN"
    },
    {
      "id": "tpl.restricted-to-sanctioned",
      "description": "FR-POL-8: restricted ke AI sanctioned = redact + log.",
      "when": [
        {"field": "direction", "op": "in", "value": ["request", "tool_call"]},
        {"field": "content.sensitivity", "op": "eq", "value": "restricted"},
        {"field": "destination.sanction", "op": "eq", "value": "sanctioned"}
      ],
      "action": "redact",
      "obligations": [{"type": "redact", "classes": ["*"]}, {"type": "log_evidence"}],
      "reason": "RESTRICTED_TO_SANCTIONED_AI"
    },
    {
      "id": "tpl.injection-high",
      "description": "FR-POL-8: injection_score >= 0.9 = block (semua arah: direct dan indirect).",
      "when": [
        {"field": "content.injection_score", "op": "gte", "value": 0.9}
      ],
      "action": "block",
      "reason": "PROMPT_INJECTION"
    },
    {
      "id": "tpl.system-prompt-leak",
      "description": "FR-PSEC-5: response yang memuat canary app atau potongan panjang system prompt-nya (exfil_score >= 0.8) = block.",
      "when": [
        {"field": "direction", "op": "eq", "value": "response"},
        {"field": "content.exfil_score", "op": "gte", "value": 0.8}
      ],
      "action": "block",
      "reason": "SYSTEM_PROMPT_LEAK"
    },
    {
      "id": "res.offshore-restricted",
      "description": "ADR-0001: konten restricted tidak boleh ke pemrosesan di luar Indonesia.",
      "when": [
        {"field": "direction", "op": "in", "value": ["request", "tool_call"]},
        {"field": "destination.region", "op": "neq", "value": "ID"},
        {"field": "content.sensitivity", "op": "eq", "value": "restricted"}
      ],
      "action": "block",
      "reason": "RESIDENCY_RESTRICTED_OFFSHORE"
    },
    {
      "id": "res.offshore-confidential",
      "description": "ADR-0001: konten confidential ke luar Indonesia harus di-redact. PEP MUST block bila redaction tidak dapat diterapkan.",
      "when": [
        {"field": "direction", "op": "in", "value": ["request", "tool_call"]},
        {"field": "destination.region", "op": "neq", "value": "ID"},
        {"field": "content.sensitivity", "op": "eq", "value": "confidential"}
      ],
      "action": "redact",
      "obligations": [{"type": "redact", "classes": ["*"]}],
      "reason": "RESIDENCY_CONFIDENTIAL_OFFSHORE"
    },
    {
      "id": "res.offshore-unsanctioned",
      "description": "ADR-0001: destinasi offshore hanya boleh bila app sanctioned (semua sensitivity).",
      "when": [
        {"field": "direction", "op": "in", "value": ["request", "tool_call"]},
        {"field": "destination.region", "op": "neq", "value": "ID"},
        {"field": "destination.sanction", "op": "neq", "value": "sanctioned"}
      ],
      "action": "block",
      "reason": "RESIDENCY_OFFSHORE_UNSANCTIONED"
    }
  ]
}
