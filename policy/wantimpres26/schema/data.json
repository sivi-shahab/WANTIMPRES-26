{
  "input": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "wantimpres26/pdp/input/v1",
    "title": "Canonical PDP input v1 (spec FR-POL-2). Never carries raw content.",
    "type": "object",
    "required": ["channel", "direction", "principal", "destination", "content"],
    "additionalProperties": false,
    "properties": {
      "channel": {"enum": ["ai_gateway", "web_proxy", "browser_ext", "endpoint", "mcp_gateway", "connector"]},
      "direction": {"enum": ["request", "response", "tool_call", "tool_result", "at_rest"]},
      "principal": {
        "type": "object",
        "required": ["type", "id"],
        "additionalProperties": false,
        "properties": {
          "type": {"enum": ["user", "agent", "service"]},
          "id": {"type": "string", "minLength": 1, "description": "Pseudonymous ID (HMAC per tenant, spec §10.2)."},
          "groups": {"type": "array", "items": {"type": "string"}},
          "risk": {"type": "number", "minimum": 0, "maximum": 1},
          "device": {"enum": ["managed", "unmanaged", "unknown"]},
          "account_context": {"enum": ["corporate", "personal", "unknown"]}
        }
      },
      "destination": {
        "type": "object",
        "required": ["app_id", "sanction", "region"],
        "additionalProperties": false,
        "properties": {
          "app_id": {"type": "string", "minLength": 1},
          "sanction": {"enum": ["sanctioned", "tolerated", "unsanctioned", "blocked", "under_review"], "description": "Apps missing from the catalog MUST be sent as unsanctioned."},
          "region": {"type": "string", "pattern": "^([A-Z]{2}|unknown)$", "description": "ISO 3166-1 alpha-2 of where content is processed; 'unknown' is treated as offshore (ADR-0001)."},
          "trains_on_data": {"type": "boolean"},
          "ojk_approval_ref": {"type": "string", "minLength": 1, "description": "OJK approval for offshore processing (POJK 11/2022); PEPs usually leave it to the catalog (wantimpres26.dest)."}
        }
      },
      "content": {
        "type": "object",
        "required": ["sensitivity", "classes"],
        "additionalProperties": false,
        "properties": {
          "sensitivity": {"enum": ["public", "internal", "confidential", "restricted"]},
          "classes": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["type", "count", "confidence"],
              "additionalProperties": false,
              "properties": {
                "type": {"type": "string", "pattern": "^(PII_ID|FIN|PCI|PHI|SECRET|CODE|LEGAL_HR|CUSTOM)\\.[A-Z0-9_]+$"},
                "count": {"type": "integer", "minimum": 1},
                "confidence": {"type": "number", "minimum": 0, "maximum": 1}
              }
            }
          },
          "injection_score": {"type": "number", "minimum": 0, "maximum": 1},
          "jailbreak_score": {"type": "number", "minimum": 0, "maximum": 1},
          "exfil_score": {"type": "number", "minimum": 0, "maximum": 1},
          "volume_ratio": {"type": "number", "minimum": 0, "description": "Entities/bytes in this event divided by the principal's baseline (FR-RISK-1 f_volume)."},
          "tokens": {"type": "integer", "minimum": 0}
        }
      },
      "agent": {
        "type": "object",
        "required": ["agent_id"],
        "additionalProperties": false,
        "properties": {
          "agent_id": {"type": "string", "minLength": 1},
          "tool": {"type": "string"},
          "tool_risk": {"enum": ["low", "medium", "high"]},
          "hitl_available": {"type": "boolean"},
          "action": {"enum": ["read", "write", "external_send", "financial"]},
          "registered": {"type": "boolean", "description": "Found in the Agent Registry. Omitted = not registered."},
          "session_injection_max": {"type": "number", "minimum": 0, "maximum": 1, "description": "Highest injection_score seen earlier in this agent session."},
          "scope_violations": {"type": "integer", "minimum": 0, "description": "Arguments of this tool call outside the registry's tool scopes (FR-AGT-4), counted by the MCP gateway."},
          "rate_exceeded": {"type": "boolean", "description": "This call is over the tool's per-agent rate (FR-AGT-4)."},
          "chain_depth": {"type": "integer", "minimum": 0, "description": "Agent-to-agent delegation hops behind this call: nesting of the token's act claim (RFC 8693)."},
          "behavior_anomalies": {"type": "array", "items": {"enum": ["new_tool", "rare_sequence", "volume_spike"]}, "description": "How this call leaves the agent's tool-call baseline (ticket 39). Omitted = nothing unusual or no baseline yet."},
          "mcp_server": {"type": "string", "minLength": 1, "description": "MCP server (gateway name) the tool belongs to; its definitions are in data.wantimpres26.mcp_tools."},
          "tool_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$", "description": "Pin of the tool definition the gateway last saw in tools/list (mcptools.Hash)."},
          "approval_granted": {"type": "boolean", "description": "A human approved exactly this call (FR-AGT-6); the gateway claimed the single-use approval."},
          "writes_memory": {"type": "boolean", "description": "The tool writes the agent's long-term memory or a vector store (FR-AGT-9); the registry's tool entry decides."}
        }
      }
    }
  },
  "output": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "wantimpres26/pdp/output/v1",
    "title": "PDP decision v1 (spec FR-POL-3)",
    "type": "object",
    "required": ["action", "obligations", "reason_codes", "matched_rules", "monitor_rules", "exempted_rules", "destination", "policy_id", "policy_version", "risk_score", "risk_overrides", "risk_version"],
    "additionalProperties": false,
    "properties": {
      "action": {"enum": ["block", "quarantine", "require_approval", "tokenize", "redact", "warn", "allow"]},
      "obligations": {
        "type": "array",
        "items": {
          "type": "object",
          "required": ["type"],
          "properties": {
            "type": {"enum": ["redact", "tokenize", "notify", "require_justification", "log_evidence"]},
            "classes": {"type": "array", "items": {"type": "string"}},
            "target": {"type": "string"}
          }
        }
      },
      "reason_codes": {"type": "array", "items": {"type": "string"}},
      "matched_rules": {"type": "array", "items": {"type": "string"}, "description": "Enforcing rules that matched."},
      "monitor_rules": {"type": "array", "items": {"type": "string"}, "description": "Monitor-only rules that matched; they never change action."},
      "exempted_rules": {"type": "array", "items": {"type": "string"}, "description": "Enforcing rules that matched but an approved exception lifted (FR-POL-7)."},
      "destination": {"type": "object", "description": "The destination decided on: the PEP's, with sanction/region/trains_on_data from the app catalog when the app is in it (ticket 16). PEPs record these in events."},
      "policy_id": {"type": "string"},
      "policy_version": {"type": "string"},
      "risk_score": {"type": "integer", "minimum": 0, "maximum": 100, "description": "FR-RISK-1/2, computed by the PDP; never supplied by the PEP."},
      "risk_overrides": {"type": "array", "items": {"type": "string"}, "description": "FR-RISK-2 overrides that applied."},
      "risk_version": {"type": "string", "description": "data.wantimpres26.risk.config.version: weights and overrides used for this score."}
    }
  }
}
