{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "wantimpres26/decision_event/v1",
  "title": "decision_event v1 (spec §6 DECISION_EVENT, §10.2). Metadata, HMAC hashes and a redacted snippet only: never raw content. The optional flat fields are the PDP input metadata, so policy simulation (ticket 12) can replay the decision.",
  "type": "object",
  "additionalProperties": false,
  "required": ["event_id", "tenant_id", "ts", "trace_id", "channel", "direction", "principal_id", "app_id", "action", "reason_codes", "policy_version", "risk_score", "risk_version", "classes", "content_hash"],
  "properties": {
    "event_id": {"type": "string", "format": "uuid"},
    "tenant_id": {"type": "string", "format": "uuid"},
    "ts": {"type": "string", "format": "date-time"},
    "trace_id": {"type": "string", "pattern": "^[0-9a-f]{32}$", "description": "W3C trace id from the PEP, propagated to detection, OPA and here."},
    "channel": {"enum": ["ai_gateway", "web_proxy", "browser_ext", "endpoint", "mcp_gateway", "connector"]},
    "direction": {"enum": ["request", "response", "tool_call", "tool_result", "at_rest"]},
    "principal_id": {"type": "string", "pattern": "^[0-9a-f]{64}$", "description": "HMAC-SHA256 with the tenant pepper (spec §10.2)."},
    "app_id": {"type": "string", "minLength": 1},
    "agent_id": {"type": "string", "minLength": 1},
    "action": {"enum": ["block", "quarantine", "require_approval", "tokenize", "redact", "warn", "allow"]},
    "reason_codes": {"type": "array", "items": {"type": "string"}},
    "matched_rules": {"type": "array", "items": {"type": "string"}},
    "policy_version": {"type": "string", "minLength": 1},
    "risk_score": {"type": "integer", "minimum": 0, "maximum": 100},
    "risk_overrides": {"type": "array", "items": {"type": "string"}},
    "risk_version": {"type": "string", "minLength": 1},
    "classes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["type", "count"],
        "properties": {
          "type": {"type": "string", "pattern": "^(PII_ID|FIN|PCI|PHI|SECRET|CODE|LEGAL_HR|CUSTOM)\\.[A-Z0-9_]+$"},
          "count": {"type": "integer", "minimum": 1},
          "confidence": {"type": "number", "minimum": 0, "maximum": 1}
        }
      }
    },
    "content_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$", "description": "HMAC-SHA256 of the content with the tenant pepper."},
    "principal_type": {"enum": ["user", "agent", "service"]},
    "principal_groups": {"type": "array", "items": {"type": "string"}},
    "principal_risk": {"type": "number", "minimum": 0, "maximum": 1},
    "device": {"enum": ["managed", "unmanaged", "unknown"]},
    "account_context": {"enum": ["corporate", "personal", "unknown"]},
    "sanction": {"enum": ["sanctioned", "tolerated", "unsanctioned", "blocked", "under_review"]},
    "region": {"type": "string", "pattern": "^([A-Z]{2}|unknown)$"},
    "trains_on_data": {"type": "boolean"},
    "sensitivity": {"enum": ["public", "internal", "confidential", "restricted"]},
    "injection_score": {"type": "number", "minimum": 0, "maximum": 1},
    "jailbreak_score": {"type": "number", "minimum": 0, "maximum": 1},
    "exfil_score": {"type": "number", "minimum": 0, "maximum": 1},
    "volume_ratio": {"type": "number", "minimum": 0},
    "tokens": {"type": "integer", "minimum": 0},
    "agent_tool": {"type": "string"},
    "tool_risk": {"enum": ["low", "medium", "high"]},
    "agent_action": {"enum": ["read", "write", "external_send", "financial"]},
    "agent_registered": {"type": "boolean"},
    "session_injection_max": {"type": "number", "minimum": 0, "maximum": 1},
    "hitl_available": {"type": "boolean"},
    "scope_violations": {"type": "integer", "minimum": 0},
    "rate_exceeded": {"type": "boolean"},
    "chain_depth": {"type": "integer", "minimum": 0},
    "behavior_anomalies": {"type": "array", "items": {"enum": ["new_tool", "rare_sequence", "volume_spike"]}},
    "source_app": {"type": "string", "minLength": 1},
    "mcp_server": {"type": "string", "minLength": 1},
    "tool_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "approval_id": {"type": "string", "minLength": 1},
    "memory_write": {"type": "boolean", "description": "The tool call writes agent memory or a vector store (FR-AGT-9)."},
    "content_origin": {"enum": ["user", "tool_result"], "description": "Provenance of a memory write: only the agent's own input this session, or tool output it read."},
    "content_sources": {"type": "array", "items": {"type": "string", "minLength": 1}, "description": "server/tool (or server/resources/read) outputs the session read before a memory write."},
    "snippet": {"type": "string", "maxLength": 200, "description": "Already redacted by the PEP, e.g. 'NIK [REDACTED:PII_ID.NIK]'."},
    "l2": {"type": "object", "additionalProperties": false, "required": ["mode", "status"],
      "description": "What the L2 model said about this content (tickets 09-10, 49): in shadow mode a report beside the L1 result for the spec 9.4 release gate. Classes and a score, never text or offsets.",
      "properties": {
        "model": {"type": "string"},
        "mode": {"enum": ["shadow", "enforce"]},
        "status": {"enum": ["ok", "timeout", "error", "skipped", "unavailable"]},
        "latency_ms": {"type": "number", "minimum": 0},
        "classes": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["type", "count"], "properties": {
          "type": {"type": "string", "pattern": "^(PII_ID|FIN|PCI|PHI|SECRET|CODE|LEGAL_HR|CUSTOM)\\.[A-Z0-9_]+$"}, "count": {"type": "integer", "minimum": 1},
          "confidence": {"type": "number", "minimum": 0, "maximum": 1}}}},
        "injection_score": {"type": "number", "minimum": 0, "maximum": 1}}}
  }
}
